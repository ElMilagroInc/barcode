{
    "name": "glpi-project/barcode",
    "description": "GLPI barcode and QR code generation plugin",
    "type": "glpi-plugin",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "autoload": {
        "classmap": [
            "inc/"
        ]
    },
    "scripts": {
        "test": "@php tests/run.php",
        "test:glpi": "@php tests/glpi-contract.php",
        "lint": "php-cs-fixer fix --dry-run --diff"
    },
    "license": "AGPL-3.0-or-later"
}
